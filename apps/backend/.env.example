# ===========================================
# Backend Environment Variables
# ===========================================
# Copy to backend/.env (dev) or set via root .env / Dokploy
# NEVER commit actual values

# Server-only secrets (never expose as VITE_)
OPENROUTER_API_KEY=
RESEND_API_KEY=
SECRET_KEY=change-me-min-32-chars
CLIENT_ID=portfolio-client
CLIENT_SECRET=change-me
ENV=dev

# Optional: custom sqlite path for refresh rotation
# REFRESH_DB_PATH=/app/data/refresh.db

# LLM model (OpenRouter ID, e.g. vendor/model:free)
OPENROUTER_MODEL=openrouter/free

# Resend sender (must use a verified domain in prod)
FROM_EMAIL=Acme <onboarding@resend.dev>
# Inbox receiving contact-form mail
CONTACT_EMAIL=contacto@juansasia.com
